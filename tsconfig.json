{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": [
    "index.ts",
    "format/**/*.ts",
    "insurers/**/*.ts",
    "parsers/**/*.ts",
    "services/**/*.ts",
    "utils/blueprint-utils.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
